<section id="audit" class="section-gap audit-section">
  <div class="container audit-grid">
    <div class="audit-info reveal reveal-left">
      <span class="eyebrow" style="color: var(--brand);">Free Website Audit</span>
      <h2>Unlock Your Website's True Growth Potential</h2>
      <p>Get a comprehensive, hand-reviewed SEO, speed, and AI-search readiness report for your site. Discover where your brand ranks in AI answers and traditional search, and how to capture more customers.</p>
      <ul class="audit-features">
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--brand)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 8px;">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>AI Search & GEO Readiness Audit</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--brand)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 8px;">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Mobile Performance & Speed Score</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--brand)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 8px;">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Competitor SEO & Market Share Analysis</span>
        </li>
      </ul>
    </div>
    
    <div class="audit-card-wrapper reveal reveal-right">
      <div class="audit-form-card">
        <h3>Request Your Free Report</h3>
        <form class="audit-form" action="/submit-audit" method="post">
          <input type="hidden" name="formToken" value="<%= auditLeadForm.token %>">
          <input type="hidden" name="formRenderedAt" value="<%= auditLeadForm.renderedAt %>">
          <div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
            <label for="audit-company">Leave this field blank</label>
            <input id="audit-company" type="text" name="bot_field_honey" tabindex="-1" autocomplete="off">
          </div>
          <div class="form-group">
            <input type="text" name="name" placeholder="Your Name" autocomplete="name" required>
          </div>
          <div class="form-group">
            <input type="url" name="website" placeholder="Website URL (https://...)" inputmode="url" autocomplete="url" required>
          </div>
          <div class="form-group">
            <input type="email" name="email" placeholder="Email Address" autocomplete="email" required>
          </div>
          <div class="form-group">
            <input type="tel" name="phone" placeholder="Mobile Number" inputmode="tel" autocomplete="tel" required>
          </div>
          <button type="submit" class="btn btn-full">Get My Audit</button>
        </form>
      </div>
    </div>
  </div>
</section>

