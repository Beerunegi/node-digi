      height: 52px;
      margin-top: 2.5rem;
      max-width: none;
    }
    .growth-badge {
      height: 52px;
      padding: 0 1.5rem;
      font-size: 1rem;
    }
    @keyframes slideCycle {
      0%, 45% { transform: translateY(0); }
      50%, 95% { transform: translateY(-52px); }
      100% { transform: translateY(0); }
    }
  }

  @media (max-width: 768px) {
    .typewriter-wrap {
      min-height: 3.5em;
      display: flex;
      align-items: center;
    }
    .typewriter-text {
      white-space: normal !important;
      word-break: break-word !important;
      line-height: 1.4;
    }
    .hero-copy h1 {
      font-size: 1.6rem;
    }
    .hero-actions .btn {
      width: 100%;
    }
  }
  .btn-full {
    width: 100% !important;
  }

  /* ==========================================================================
     MODERN HOME ENHANCEMENTS
     Layered ambience, depth, and micro-interactions.
     Every animation is switched off in the prefers-reduced-motion block at the
     end, and nothing here gates content visibility -- all of it is decoration
     painted on top of markup that is already visible.
     ========================================================================== */

  /* --- Hero ambience ---------------------------------------------------- */

  /* Slow-drifting colour field. Above the photo overlay, below the copy. */
  .hero-aurora {
    position: absolute;
    inset: -30%;
    z-index: 1;
    pointer-events: none;
    opacity: 0.5;
    background:
      radial-gradient(38% 44% at 18% 28%, rgba(0, 194, 255, 0.42), transparent 62%),
      radial-gradient(34% 40% at 82% 22%, rgba(160, 0, 255, 0.34), transparent 64%),
      radial-gradient(42% 48% at 62% 82%, rgba(1, 160, 157, 0.36), transparent 66%),
      radial-gradient(30% 36% at 30% 76%, rgba(255, 81, 47, 0.24), transparent 62%);
    filter: blur(28px);
    animation: auroraDrift 24s ease-in-out infinite alternate;
  }

  @keyframes auroraDrift {
    0%   { transform: translate3d(0, 0, 0) rotate(0deg) scale(1); }
    50%  { transform: translate3d(2.5%, -2%, 0) rotate(4deg) scale(1.08); }
    100% { transform: translate3d(-2%, 2.5%, 0) rotate(-3deg) scale(1.04); }
  }

  /* Technical grid, masked at the edges so it never reads as a box. */
  .hero-grid-overlay {
    position: absolute;
    inset: -64px;
    z-index: 1;
    pointer-events: none;
    opacity: 0.5;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(80% 70% at 30% 45%, #000 0%, transparent 78%);
    mask-image: radial-gradient(80% 70% at 30% 45%, #000 0%, transparent 78%);
    animation: gridPan 32s linear infinite;
  }

  @keyframes gridPan {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(64px, 64px, 0); }
  }

  /* One slow specular sweep across the hero. */
  .hero-shine {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-shine::before {
    content: "";
    position: absolute;
    top: -60%;
    left: -30%;
    width: 28%;
    height: 220%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.09), transparent);
    will-change: transform;
    animation: heroSweep 9s ease-in-out 2s infinite;
  }

  @keyframes heroSweep {
    0%, 70%, 100% { transform: translate3d(0, 0, 0) rotate(14deg);    opacity: 0; }
    18%           {                                                   opacity: 1; }
    55%           { transform: translate3d(520%, 0, 0) rotate(14deg); opacity: 0; }
  }

  /* --- Hero headline ----------------------------------------------------- */

  /* Gradient accent on the closing word. Scoped to a span so the H1 text and
     its LCP paint are untouched. */
  .hero-gradient-text {
    background: linear-gradient(100deg, #4fd8ff 0%, #a78bfa 45%, #4fd8ff 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    text-shadow: none;
    animation: gradientSlide 7s linear infinite;
  }

  @keyframes gradientSlide {
    to { background-position: 220% 0; }
  }

  .hero-copy .eyebrow {
    position: relative;
    padding: 6px 14px 6px 26px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(8px);
    color: #dbeafe;
  }

  /* Live indicator on the eyebrow pill. */
  .hero-copy .eyebrow::before {
    content: "";
    position: absolute;
    left: 11px;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -3.5px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.7);
    animation: pulseDot 2.4s ease-out infinite;
  }

  @keyframes pulseDot {
    0%   { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.7); }
    70%  { box-shadow: 0 0 0 9px rgba(52, 211, 153, 0); }
    100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
  }

  /* --- Buttons ----------------------------------------------------------- */

  .hero-single .btn,
  .final-cta .btn,
  .home-about-copy .btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-single .btn::after,
  .final-cta .btn::after,
  .home-about-copy .btn::after {
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.42), transparent);
    transform: skewX(-18deg);
    transition: left 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: -1;
  }

  .hero-single .btn:hover::after,
  .final-cta .btn:hover::after,
  .home-about-copy .btn:hover::after {
    left: 130%;
  }

  /* --- Scroll cue -------------------------------------------------------- */

  .hero-scroll-cue {
    display: none;
    align-items: center;
    gap: 10px;
    margin: 0 0 1.5rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    width: fit-content;
    transition: color 0.3s ease;
  }

  .hero-scroll-cue:hover { color: #fff; }

  .hero-scroll-cue-track {
    position: relative;
    display: block;
    width: 22px;
    height: 34px;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    flex-shrink: 0;
  }

  .hero-scroll-cue-dot {
    position: absolute;
    left: 50%;
    top: 7px;
    width: 3.5px;
    height: 7px;
    margin-left: -1.75px;
    border-radius: 999px;
    background: #fff;
    animation: scrollCue 1.9s ease-in-out infinite;
  }

  @keyframes scrollCue {
    0%, 100% { transform: translateY(0);    opacity: 0; }
    30%      {                              opacity: 1; }
    70%      { transform: translateY(11px); opacity: 0; }
  }

  /* --- Reading progress bar ---------------------------------------------- */

  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 100%;
    transform: scaleX(var(--scroll-progress, 0));
    transform-origin: 0 50%;
    background: linear-gradient(90deg, #00c2ff, #a78bfa 55%, #ff512f);
    z-index: 999;
    pointer-events: none;
    will-change: transform;
  }

  /* --- Shared card treatments -------------------------------------------- */

  /* Cursor-tracking sheen. --mx and --my are written by main.js; the fallback
     keeps the highlight centred if that script never runs. */
  .why-stat-card-new,
  .home-service-card,
  .intent-card,
  .testimonial-card {
    position: relative;
    isolation: isolate;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.45s ease;
  }

  .why-stat-card-new::before,
  .home-service-card::before,
  .intent-card::before,
  .testimonial-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 50%),
      rgba(0, 194, 255, 0.13),
      transparent 62%
    );
    z-index: -1;
    pointer-events: none;
  }

  .why-stat-card-new:hover::before,
  .home-service-card:hover::before,
  .intent-card:hover::before,
  .testimonial-card:hover::before {
    opacity: 1;
  }

  .why-stat-card-new:hover,
  .intent-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.13);
  }

  /* --- Stat dashboard ----------------------------------------------------- */

  .why-stat-card-new { overflow: hidden; }

  /* Gradient hairline that wipes in along the top edge on hover. */
  .why-stat-card-new::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #00c2ff, #a78bfa, #ff512f);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .why-stat-card-new:hover::after { transform: scaleX(1); }

  .why-stat-card-new .stat-number {
    background: linear-gradient(135deg, #0a2540, #0188ff 60%, #00c2ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    font-variant-numeric: tabular-nums;
  }

  /* --- Service cards ------------------------------------------------------ */

  .home-service-card { overflow: hidden; }

  .home-service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(15, 23, 42, 0.16);
  }

  .home-service-media {
    display: block;
    overflow: hidden;
    position: relative;
  }

  .home-service-media img {
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-service-card:hover .home-service-media img { transform: scale(1.07); }

  /* Wash that deepens over the image on hover. */
  .home-service-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 37, 64, 0.55), transparent 58%);
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  .home-service-card:hover .home-service-media::after { opacity: 1; }

  .home-service-chip {
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-service-card:hover .home-service-chip { transform: translateY(-3px); }

  /* Arrow slides out of the link on hover. */
  .home-service-body .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .home-service-body .card-link::after {
    content: "\2192";
    display: inline-block;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-service-card:hover .card-link::after { transform: translateX(5px); }

  /* --- Growth framework ---------------------------------------------------- */

  .intent-card .intent-num {
    transition: color 0.4s ease, transform 0.4s ease;
  }

  .intent-card:hover .intent-num {
    color: #0188ff;
    transform: scale(1.08);
  }

  .intent-card .intent-glyph {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .intent-card:hover .intent-glyph { transform: rotate(-8deg) scale(1.12); }

  /* --- Section headings ----------------------------------------------------- */

  .why-choose-head h2,
  .intent-framework-head h2,
  .home-services-modern .section-head h2 {
    position: relative;
    display: inline-block;
    padding-bottom: 14px;
  }

  .why-choose-head h2::after,
  .intent-framework-head h2::after,
  .home-services-modern .section-head h2::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 84px;
    border-radius: 999px;
    background: linear-gradient(90deg, #00c2ff, #a78bfa);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
  }

  /* Draws itself once the surrounding block is revealed, reusing the existing
     IntersectionObserver rather than adding another. */
  .why-choose-head.show h2::after,
  .intent-framework-head.show h2::after,
  .home-services-modern .section-head h2::after {
    transform: scaleX(1);
  }

  /* --- Trust marquee --------------------------------------------------------- */

  .trust-strip .marquee {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .partner-pill {
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .partner-pill:hover { transform: translateY(-3px); }

  /* --- Final CTA -------------------------------------------------------------- */

  .final-cta .final-cta-inner {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .final-cta .final-cta-inner::before {
    content: "";
    position: absolute;
    inset: -50%;
    z-index: -1;
    background:
      radial-gradient(36% 44% at 20% 30%, rgba(0, 194, 255, 0.30), transparent 62%),
      radial-gradient(32% 40% at 78% 68%, rgba(167, 139, 250, 0.28), transparent 64%),
      radial-gradient(30% 38% at 55% 20%, rgba(255, 81, 47, 0.20), transparent 62%);
    filter: blur(26px);
    animation: auroraDrift 26s ease-in-out infinite alternate;
    pointer-events: none;
  }

  /* --- Larger screens ---------------------------------------------------------- */

  @media (min-width: 900px) {
    .hero-scroll-cue { display: inline-flex; }
    .hero-aurora { opacity: 0.62; }
  }

  /* --- Motion preferences -------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {
    .hero-aurora,
    .hero-grid-overlay,
    .hero-gradient-text,
    .hero-copy .eyebrow::before,
    .hero-scroll-cue-dot,
    .final-cta .final-cta-inner::before {
      animation: none !important;
    }

    /* Gradient text still needs a painted fill once the slide is off. */
    .hero-gradient-text { background-position: 0 0; }

    .hero-shine { display: none; }
    .scroll-progress { display: none; }

    .why-stat-card-new:hover,
    .intent-card:hover,
    .home-service-card:hover,
    .partner-pill:hover,
    .home-service-card:hover .home-service-media img,
    .intent-card:hover .intent-glyph,
    .intent-card:hover .intent-num,
    .home-service-card:hover .card-link::after,
    .home-service-card:hover .home-service-chip {
      transform: none;
    }

    .why-choose-head h2::after,
    .intent-framework-head h2::after,
    .home-services-modern .section-head h2::after,
    .why-stat-card-new::after {
      transform: scaleX(1);
      transition: none;
    }
  }


  /* ==========================================================================
     TESTIMONIALS — modern rebuild
     Overrides the base rules in style.css. Structure is unchanged; this is a
     visual pass plus two real layout fixes (uneven card bottoms, and platform
     badges that were identical for three different sources).
     ========================================================================== */

  .testimonials-section {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 0% 15%, rgba(59, 130, 246, 0.10), transparent 34%),
      radial-gradient(circle at 100% 85%, rgba(6, 182, 212, 0.10), transparent 30%),
      linear-gradient(180deg, #f9fcff 0%, #eef5ff 100%);
  }

  /* Faint dot field for texture; masked so it never meets the section edges. */
  .testimonials-section::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(rgba(10, 37, 64, 0.055) 1px, transparent 1px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(70% 60% at 50% 40%, #000, transparent 76%);
    mask-image: radial-gradient(70% 60% at 50% 40%, #000, transparent 76%);
  }

  .testimonials-section > .container {
    position: relative;
    z-index: 1;
  }

  .testimonials-head {
    align-items: center;
    gap: 32px;
    margin-bottom: 40px;
  }

  /* --- Proof stats ------------------------------------------------------- */

  .testimonials-proof article {
    position: relative;
    overflow: hidden;
    padding: 22px 22px 20px;
    border-radius: 22px;
    border: 1px solid rgba(59, 130, 246, 0.16);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.96), rgba(243, 249, 255, 0.9));
    box-shadow: 0 18px 40px rgba(15, 33, 58, 0.08);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease;
  }

  .testimonials-proof article::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #3b82f6, #06b6d4);
  }

  .testimonials-proof article:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 52px rgba(15, 33, 58, 0.13);
  }

  .testimonials-proof strong {
    margin-bottom: 8px;
    font-family: "Sora", sans-serif;
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    background: linear-gradient(135deg, #0a2540 0%, #2563eb 55%, #06b6d4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    font-variant-numeric: tabular-nums;
  }

  .testimonials-proof span {
    font-size: 0.85rem;
    line-height: 1.55;
    color: #5f7184;
  }

  /* --- Card shell -------------------------------------------------------- */

  .testimonials-grid-pro {
    gap: 22px;
  }

  .testimonial-card {
    /* Flex column so the author block can be pinned to the bottom -- cards
       previously ended at different heights when quotes differed in length. */
    display: flex;
    flex-direction: column;
    padding: 28px 26px 26px;
    border-radius: 26px;
    border: 1px solid rgba(59, 130, 246, 0.14);
    background:
      radial-gradient(circle at top right, rgba(59, 130, 246, 0.07), transparent 42%),
      #ffffff;
    box-shadow: 0 16px 40px rgba(15, 33, 58, 0.07);
  }

  .testimonial-card:hover {
    border-color: rgba(59, 130, 246, 0.3);
    box-shadow: 0 30px 60px rgba(15, 33, 58, 0.14);
  }

  /* --- Ghosted quote glyph ------------------------------------------------ */

  /* Was a filled blue rounded square. Now an oversized watermark that sits
     behind the copy and warms up on hover. */
  .testimonial-card .testimonial-quote-mark {
    position: absolute;
    top: 46px;
    right: 20px;
    z-index: 0;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    border-radius: 0;
    background: none;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 7rem;
    line-height: 1;
    color: rgba(59, 130, 246, 0.1);
    pointer-events: none;
    transition: color 0.45s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .testimonial-card:hover .testimonial-quote-mark {
    color: rgba(59, 130, 246, 0.18);
    transform: translateY(-4px) scale(1.04);
  }

  .testimonial-card > *:not(.testimonial-quote-mark) {
    position: relative;
    z-index: 1;
  }

  /* --- Rating ------------------------------------------------------------- */

  .testimonial-top {
    margin-bottom: 18px;
  }

  .testimonial-stars-container {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .testimonial-card .rating {
    font-family: "Sora", sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #0a2540;
  }

  /* Stars inherited the dark body colour, so a 5-star rating read as black. */
  .testimonial-stars {
    display: inline-flex;
    gap: 1px;
  }

  .testimonial-stars span {
    color: #f5a524;
    font-size: 0.9rem;
    line-height: 1;
    text-shadow: 0 1px 3px rgba(245, 165, 36, 0.35);
  }

  /* --- Platform badges ----------------------------------------------------- */

  /* All three sources previously rendered in the same pale blue. Colour-coding
     them makes the social proof legible at a glance. */
  .testimonial-card .platform {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 11px;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .testimonial-card .platform::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  .testimonial-card .platform-google {
    background: rgba(66, 133, 244, 0.11);
    border-color: rgba(66, 133, 244, 0.28);
    color: #1a63d8;
  }

  .testimonial-card .platform-clutch {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.26);
    color: #d03535;
  }

  .testimonial-card .platform-meta {
    background: rgba(124, 58, 237, 0.1);
    border-color: rgba(124, 58, 237, 0.26);
    color: #6d28d9;
  }

  /* --- Quote copy ----------------------------------------------------------- */

  .testimonial-card p {
    margin: 0 0 18px;
    font-size: 1rem;
    line-height: 1.7;
    color: #33445c;
  }

  /* --- Result pill ----------------------------------------------------------- */

  .testimonial-metric {
    /* margin-top:auto pushes this and the author block to the card foot, so
       every card lines up regardless of quote length. */
    margin-top: auto;
    align-self: flex-start;
    gap: 7px;
    padding: 9px 15px;
    border: 1px solid rgba(16, 185, 129, 0.24);
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(6, 182, 212, 0.1));
    color: #0f7a5f;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.35;
  }

  .testimonial-metric::before {
    content: "\2197";
    font-size: 0.85rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* --- Author ---------------------------------------------------------------- */

  .testimonial-user {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid rgba(10, 37, 64, 0.07);
  }

  .testimonial-avatar {
    position: relative;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    flex-shrink: 0;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px rgba(59, 130, 246, 0.22);
    transition: box-shadow 0.4s ease;
  }

  .testimonial-card:hover .testimonial-avatar {
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px rgba(59, 130, 246, 0.45);
  }

  /* Verified tick, drawn rather than added to the markup. */
  .testimonial-avatar::after {
    content: "\2713";
    position: absolute;
    right: -3px;
    bottom: -3px;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 2px solid #ffffff;
    background: linear-gradient(135deg, #10b981, #059669);
    color: #ffffff;
    font-size: 0.55rem;
    font-weight: 700;
    line-height: 1;
  }

  .testimonial-user > div {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .testimonial-user strong {
    font-size: 0.92rem;
    color: #0a2540;
  }

  .testimonial-user span {
    font-size: 0.8rem;
    color: #64748b;
  }

  /* --- Featured card ---------------------------------------------------------- */

  .testimonial-card-featured {
    border-color: rgba(59, 130, 246, 0.3);
    background:
      radial-gradient(circle at top right, rgba(34, 211, 238, 0.13), transparent 40%),
      linear-gradient(155deg, #ffffff 0%, #f4f9ff 100%);
    box-shadow: 0 24px 54px rgba(37, 99, 235, 0.15);
  }

  .testimonial-card-featured::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #2563eb, #06b6d4, #10b981);
    border-radius: 26px 26px 0 0;
  }

  .testimonial-card-featured .testimonial-quote-mark {
    color: rgba(37, 99, 235, 0.16);
  }

  /* --- Narrow screens ----------------------------------------------------------- */

  @media (max-width: 760px) {
    .testimonial-card {
      padding: 24px 20px 22px;
    }

    .testimonial-card .testimonial-quote-mark {
      font-size: 5.5rem;
      top: 40px;
    }

    .testimonials-head {
      gap: 24px;
      margin-bottom: 28px;
    }
  }

  /* --- Motion preferences ---------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {
    .testimonials-proof article:hover,
    .testimonial-card:hover .testimonial-quote-mark {
      transform: none;
    }
  }


  /* ==========================================================================
     OUR WORK — bento showcase
     Replaces the previous flat "Case Studies" grid. Same four clients as
     /case-studies, now including Ankur Pharmaceuticals, which the homepage
     had been omitting.
     ========================================================================== */

  .work-section {
    position: relative;
    /* No overflow clipping here: it would make the section a scroll container
       and stop the sticky panels inside from pinning. */
    background:
      radial-gradient(circle at 8% 0%, rgba(59, 130, 246, 0.09), transparent 32%),
      radial-gradient(circle at 95% 100%, rgba(16, 185, 129, 0.08), transparent 30%),
      #ffffff;
  }

  .work-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 26px;
    margin-bottom: 36px;
  }

  .work-head p {
    max-width: 620px;
    margin-bottom: 0;
  }

  .work-head-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: 999px;
    border: 1px solid rgba(59, 130, 246, 0.28);
    background: rgba(59, 130, 246, 0.06);
    color: #1d4ed8;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    transition: background 0.35s ease, border-color 0.35s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .work-head-link span {
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .work-head-link:hover {
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.5);
    transform: translateY(-2px);
  }

  .work-head-link:hover span { transform: translateX(4px); }


  /* ==========================================================================
     OUR WORK — sticky stacked panels
     Each panel sticks a little lower than the one before, so earlier cards
     stay visible as coloured slivers while the next slides over them. Four
     full-bleed panels occupy roughly one panel of screen at a time.
     ========================================================================== */

  .work-stack {
    /* Offset keeps panels clear of the sticky site header. */
    --stack-top: 96px;
    --stack-peek: 16px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
