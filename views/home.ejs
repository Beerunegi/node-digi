  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 0;
    opacity: 0.15;
    pointer-events: none;
    animation: blobFloat 20s infinite alternate cubic-bezier(0.45, 0, 0.55, 1);
