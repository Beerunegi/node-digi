  .btn-whatsapp:hover {
    box-shadow: 0 15px 30px rgba(37, 211, 102, 0.35);
  }

  /* Hero Metrics Refinement - Clean Look */
  .hero-metrics-floating {
    margin-top: 2rem;
  }

  /* Floating Growth Slider */
  .hero-growth-slider {
    position: relative;
    height: 48px;
