    100% { transform: translateY(0); }
  }

  @keyframes driftBadge {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-4px) rotate(0.5deg); }
  }

  .typewriter-wrap {
    display: block;
    min-height: 1.35em;
