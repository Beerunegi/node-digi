<section id="audit" data-nav-label="Free Audit" class="section-gap audit-section">
  <div class="container audit-grid">
    <div class="audit-info reveal reveal-left">
      <span class="eyebrow" style="color: var(--brand);">Free Website Audit</span>
      <h2>Unlock Your Website's True Growth Potential</h2>
      <p>A hand-reviewed report on where your site stands in both AI answers and traditional search &mdash; and what to fix first.</p>
      <ul class="audit-features">
        <li>AI Search &amp; GEO readiness</li>
        <li>Mobile performance &amp; speed</li>
        <li>Competitor &amp; market share</li>
        <li>Technical SEO issues</li>
      </ul>
    </div>
    
    <div class="audit-card-wrapper reveal reveal-right">
      <div class="audit-form-card">
        <h3>Request your free report</h3>
        <form class="audit-form" action="/submit-audit" method="post">
          <input type="hidden" name="formToken" value="<%= auditLeadForm.token %>">
          <input type="hidden" name="formRenderedAt" value="<%= auditLeadForm.renderedAt %>">
          <div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
            <label for="audit-company">Leave this field blank</label>
            <input id="audit-company" type="text" name="bot_field_honey" tabindex="-1" autocomplete="off">
          </div>
          <div class="audit-form-row">
            <div class="form-group">
              <label class="visually-hidden" for="home-audit-name">Your Name</label>
              <input type="text" id="home-audit-name" name="name" placeholder="Your Name" autocomplete="name" required>
            </div>
            <div class="form-group">
              <label class="visually-hidden" for="home-audit-website">Website URL</label>
              <input type="url" id="home-audit-website" name="website" placeholder="Website URL" inputmode="url" autocomplete="url" required>
            </div>
          </div>
          <div class="audit-form-row">
            <div class="form-group">
              <label class="visually-hidden" for="home-audit-email">Email Address</label>
              <input type="email" id="home-audit-email" name="email" placeholder="Email Address" autocomplete="email" required>
            </div>
            <div class="form-group">
              <label class="visually-hidden" for="home-audit-phone">Mobile Number</label>
              <input type="tel" id="home-audit-phone" name="phone" placeholder="Mobile Number" inputmode="tel" autocomplete="tel" required>
            </div>
          </div>
          <button type="submit" class="btn btn-full">Get my free audit</button>
          <p class="audit-form-note">No obligation. We reply within 2 working days.</p>
        </form>
      </div>
    </div>
  </div>
</section>

