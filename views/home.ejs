  }

  .typewriter-text {
    color: #a000ff;
    text-shadow: 0 0 10px rgba(160, 0, 255, 0.3);
    white-space: nowrap;
    border-right: 3px solid #a000ff;
    padding-right: 6px;
    animation: typingCursor 0.8s step-end infinite;
  }

  @keyframes typingCursor {
    50% { border-color: transparent; }
  }

  /* Desktop Enhancements */
  @media (min-width: 769px) {
    .hero-single {
      min-height: 70vh;
      padding: 6rem 0;
    }
    .container.hero-left-layout {
      padding: 0 2rem;
